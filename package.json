{
  "name": "market-data",
  "description": "The read side of Chance (CQRS): market lists with current prices and price history per tenant, projected from the events of markets and trading and rebuilt from its own copy of them.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "replay": "node dist/replay.js",
    "backfill": "node dist/backfill.js",
    "parked": "node dist/parked.js"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.8",
    "graphql": "17.1.0",
    "jose": "^6.2.16",
    "mercurius": "16.12.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
